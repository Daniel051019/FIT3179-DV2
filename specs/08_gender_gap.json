{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#40545d",
      "titleColor": "#40545d",
      "gridColor": "#e9eeeb",
      "domain": false,
      "tickColor": "#c8d3d0",
      "labelLimit": 420,
      "labelPadding": 6,
      "gridOpacity": 0.65
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "titleLimit": 500,
      "labelLimit": 350,
      "columns": 1
    },
    "title": {
      "font": "Arial",
      "fontSize": 16,
      "anchor": "start"
    }
  },
  "height": 600,
  "data": {
    "url": "data/study_outcomes.json"
  },
  "transform": [
    {
      "filter": "datum.year == 2025"
    },
    {
      "filter": "isValid(datum.gap_pct)"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "gap_pct",
      "type": "quantitative",
      "title": "Male–female median salary gap (% of male median)"
    },
    "color": {
      "condition": {
        "test": "datum.gap_pct >= 0",
        "value": "#4b55a3"
      },
      "value": "#bb6656"
    },
    "tooltip": [
      {
        "field": "field",
        "type": "nominal",
        "title": "Study area"
      },
      {
        "field": "gap_pct",
        "type": "quantitative",
        "title": "Gender gap (%)",
        "format": "0.1f"
      }
    ],
    "opacity": {
      "condition": {
        "test": "followField === '' || datum.field === followField",
        "value": 1
      },
      "value": 0.16
    }
  },
  "params": [
    {
      "name": "followField",
      "value": ""
    }
  ],
  "usermeta": {
    "linkedField": true
  }
}